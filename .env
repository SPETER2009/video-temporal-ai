# ─── API Keys ────────────────────────────────────────────
# Get your free key at: https://ai.google.dev
GEMINI_API_KEY=AQ.Ab8RN6L7d6aza7FpnQsvJsgcil8FMZ3ZQZrxMQvR1UX47Jzozg

# ─── Model Settings ───────────────────────────────────────
# Options: gemini-3.5-flash (fast & reliable) | gemini-3.7-flash | gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.5-flash

# ─── Video Processing ─────────────────────────────────────
# FPS to sample for frame analysis (1 = 1 frame/sec, fine for most videos)
SAMPLE_FPS=1
# Max video duration to auto-process without chunking (seconds)
MAX_DIRECT_DURATION=300

# ─── YOLO Tracking ────────────────────────────────────────
# YOLOv8 model size: yolov8n (fastest) | yolov8s | yolov8m | yolov8l
YOLO_MODEL=yolov8n.pt
# Detection confidence threshold (0.0–1.0)
YOLO_CONF=0.35

# ─── App Settings ─────────────────────────────────────────
# Streamlit port
PORT=8501
# Temp directory for uploaded videos
UPLOAD_DIR=./temp_uploads
